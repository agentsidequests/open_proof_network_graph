section

namespace Erdos345

open IsAddComplete

/-- The set of $k$-th powers of positive integers. -/
def kthPowers (k : ℕ) : Set ℕ :=
  {x | ∃ n : ℕ, 0 < n ∧ n ^ k = x}

end Erdos345
